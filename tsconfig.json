{
  "compilerOptions": {
    "allowJs": false,
    "target": "es5",
    "types": ["node", "jest"],
    "module": "amd",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outFile": "./dist/index.js"
  },
  "include": ["./src/**/*"]
}
